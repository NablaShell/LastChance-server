{
    email {$ACME_EMAIL}
    admin off
    auto_https disable_redirects
}

{$DOMAIN} {
    tls {
        protocols tls1.3
    }

    # Anti-Scanning Stealth Layer
    @stealth {
        header {$STEALTH_HEADER_NAME} {$STEALTH_HEADER_VALUE}
    }

    handle @stealth {
        # Core Message Relay API
        handle /api-v1/* {
            reverse_proxy sms-relay:8080
        }

        # File Transfer API
        handle /file-api/* {
            reverse_proxy file-relay:8081 {
                flush_interval -1
            }
        }

        # TODO: Admin Dashboard Section
        # handle /admin/* {
        #     reverse_proxy admin-panel:8082
        # }

        # Default fallback for authorized requests
        handle {
            respond "" 404
        }
    }

    # Unauthorized requests - Silent Drop
    handle {
        respond "" 403
    }

    log {
        output file /var/log/caddy/last-chance.log
        format json
    }
}

# Block direct IP access and insecure HTTP
http:// {
    respond "" 403
}
