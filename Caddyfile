# LastChance edge proxy.
#
# Caddy terminates TLS 1.3 and forwards:
#   /push*, /pull*                 -> lc-server:8080 (relay)
#   /upload*, /download*           -> lc-server:8081 (files)
#
# The lc-server container publishes no host ports; only Caddy is reachable.
# All {$VAR} values must be set (see env.example). Validate with:
#
#     caddy validate --config Caddyfile --adapter caddyfile --envfile .env

{
	email {$ACME_EMAIL}
	admin off
	auto_https disable_redirects
}

{$DOMAIN} {
	tls {
		protocols tls1.3
	}

	# Anti-scanning stealth layer. lc-server re-checks the same header.
	@stealth {
		header {$STEALTH_HEADER_NAME} {$STEALTH_HEADER_VALUE}
	}

	handle @stealth {
		# --- Text relay (relay listener) ---
		handle /push* {
			request_body {
				max_size {$LC_MAX_BODY_BYTES:1048576}
			}
			reverse_proxy lc-server:8080 {
				# Overwrite, never append: a client-supplied X-Real-IP must not
				# reach the relay.
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
			}
		}

		handle /pull* {
			request_body {
				max_size {$LC_MAX_BODY_BYTES:1048576}
			}
			reverse_proxy lc-server:8080 {
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
			}
		}

		# --- File relay (files listener) ---
		handle /upload* {
			request_body {
				max_size {$LC_MAX_FILE_BYTES:134217728}
			}
			reverse_proxy lc-server:8081 {
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
			}
		}

		handle /download* {
			reverse_proxy lc-server:8081 {
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
				# Stream downloads without buffering.
				flush_interval -1
			}
		}

		# --- Legacy prefixes (optional, backward compatibility) ---
		# handle_path strips /api-v1 and /file-api before proxying. The client
		# signs the unprefixed path (/push/..., /upload, /download/...), so the
		# signature contract is unchanged.
		handle_path /api-v1/* {
			request_body {
				max_size {$LC_MAX_BODY_BYTES:1048576}
			}
			reverse_proxy lc-server:8080 {
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
			}
		}

		handle_path /file-api/* {
			request_body {
				max_size {$LC_MAX_FILE_BYTES:134217728}
			}
			reverse_proxy lc-server:8081 {
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
				flush_interval -1
			}
		}

		handle {
			respond "" 404
		}
	}

	# Requests without the stealth header are dropped.
	handle {
		respond "" 403
	}

	# Access logging is intentionally disabled: a privacy relay must not
	# persist client IPs and URIs by default. To opt in, mount a volume for
	# /var/log/caddy and enable a bounded log:
	#
	# log {
	#     output file /var/log/caddy/access.log {
	#         roll_size 10MiB
	#         roll_keep 3
	#         roll_keep_for 72h
	#     }
	#     format json
	# }
}

# -----------------------------------------------------------------------------
# Variant B: separate subdomain for file traffic.
#
# Uncomment this block and remove the /upload* and /download* handles above.
# Add FILES_DOMAIN to .env and point its DNS record at this host. The relay
# remains on DOMAIN; files are isolated on their own hostname.
#
# {$FILES_DOMAIN} {
# 	tls {
# 		protocols tls1.3
# 	}
