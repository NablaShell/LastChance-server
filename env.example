# ==============================================================================
# Last Chance Server - Infrastructure Configuration
# ==============================================================================

### Domain & Network Settings ###
# Your public domain name (e.g., node-01.example.com or duckdns address)
DOMAIN=example.com

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=operator@example.com

### Stealth Security Layer ###
# Secret header name to bypass the proxy "abort" rule (Anti-Scanning)
STEALTH_HEADER_NAME=X-DNS-Connect

# Secret header value required for all incoming requests
STEALTH_HEADER_VALUE=Your_Secret_Passphrase_Here

### Application Security ###
# Secret key used for signing and validating Admin JWT tokens
# Generate a strong one using: openssl rand -hex 32
# TODO: ADMIN_JWT_SECRET=generate_your_own_secret_key_here

### Storage Settings ###
# Path inside the container for file storage (default recommended)
VAULT_PATH=/var/lib/lastchance/vault

### Resource Limits (Optional hints for Docker) ###
# TODO: SMS_RELAY_MEMORY_LIMIT=256M
# TODO: FILE_RELAY_MEMORY_LIMIT=512M
