# ==============================================================================
# Last Chance Server - Infrastructure Configuration
# ==============================================================================
#
# Copy this file to .env and fill in every value. All four variables below are
# required: `docker compose up` refuses to start when one is missing, and Caddy
# fails to parse its Caddyfile when DOMAIN, ACME_EMAIL, STEALTH_HEADER_NAME or
# STEALTH_HEADER_VALUE expands to an empty string.
#
# Validate the Caddyfile locally with the same environment:
#
#     caddy validate --config Caddyfile --adapter caddyfile --envfile .env
#     # or, on a clean checkout:
#     caddy validate --config Caddyfile --adapter caddyfile --envfile env.example

### Domain & Network Settings ###
# Your public domain name (e.g., node-01.example.com or duckdns address)
DOMAIN=example.com

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=operator@example.com

### Stealth Security Layer ###
# Secret header name to bypass the proxy "abort" rule (Anti-Scanning).
# Keep these values in .env (never commit .env). Rotate by editing .env and
# running `docker compose up -d`; no rebuild is required. Leaving either value
# empty fails closed: Caddy and both relays reject every request.
# NOTE: this hides the relay from casual scanning. It is NOT an access-control
# boundary against anyone who learns the value. The real boundary is TLS 1.3
# plus the Ed25519 signature on every API request.
STEALTH_HEADER_NAME=X-DNS-Connect

# Secret header value required for all incoming requests
# Generate one with, for example: openssl rand -base64 32
STEALTH_HEADER_VALUE=Your_Secret_Passphrase_Here

### Client IP / Trusted Proxy ###
# Optional. Comma- or space-separated CIDRs (or bare IPs) whose X-Real-IP
# header is trusted. Caddy is the only legitimate proxy in the shipped
# single-host deployment, so narrowing this to its address or the Docker
# bridge subnet stops other hosts on the same RFC1918 network from spoofing
# the client IP used for rate limiting and logging.
#
# When unset, every loopback / RFC1918 / ULA peer is trusted (legacy
# behaviour, kept so an existing deployment does not change silently).
# Example for the default compose bridge (check `docker network inspect`):
# TRUSTED_PROXY_CIDR=172.18.0.2/32
TRUSTED_PROXY_CIDR=

### Application Security ###
# Secret key used for signing and validating Admin JWT tokens
# Generate a strong one using: openssl rand -hex 32
# TODO: ADMIN_JWT_SECRET=generate_your_own_secret_key_here

### Storage Settings ###
# Path inside the container for file storage (default recommended)
VAULT_PATH=/var/lib/lastchance/vault

### Resource Limits (Optional hints for Docker) ###
# TODO: SMS_RELAY_MEMORY_LIMIT=256M
# TODO: FILE_RELAY_MEMORY_LIMIT=512M
