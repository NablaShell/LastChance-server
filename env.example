# LastChance server deployment environment.
#
# Copy this file to .env and fill in every required value. docker compose
# refuses to start when DOMAIN, ACME_EMAIL, STEALTH_HEADER_NAME or
# STEALTH_HEADER_VALUE is missing.
#
# Validate the Caddyfile with the same environment:
#
#     caddy validate --config Caddyfile --adapter caddyfile --envfile .env
#     # or on a clean checkout:
#     caddy validate --config Caddyfile --adapter caddyfile --envfile env.example

### Required: public domain and ACME ###
DOMAIN=example.com
ACME_EMAIL=operator@example.com

### Required: anti-scanning header ###
# Caddy and lc-server must share these values. They are not an access-control
# boundary against someone who learns them; the real boundary is TLS 1.3 plus
# the Ed25519 request signature.
STEALTH_HEADER_NAME=X-DNS-Connect
STEALTH_HEADER_VALUE=replace_with_a_random_secret

### Optional: trusted proxy allow-list ###
# Comma- or space-separated CIDRs/IPs whose X-Real-IP is trusted. Unset keeps
# the legacy loopback/RFC1918/ULA behaviour. In the shipped compose setup,
# pin Caddy's container address or the Docker bridge subnet to narrow trust.
TRUSTED_PROXY_CIDR=

### Optional: edge request limits (must match the server config) ###
LC_MAX_BODY_BYTES=1048576
LC_MAX_FILE_BYTES=134217728

### Optional: separate files subdomain (Variant B in Caddyfile) ###
# Uncomment together with the Variant B block in Caddyfile.
# FILES_DOMAIN=files.example.com

### Optional: lc-server overrides ###
# The container reads /config/config.toml. The values below override it and
# are normally left unset; edit the TOML file instead.
# LC_RELAY_ADDR=0.0.0.0:8080
# LC_FILES_ADDR=0.0.0.0:8081
# LC_PULL_TIMEOUT_SEC=30
# LC_RELAY_PULL_MAX_CONCURRENT=64
# LC_FILE_TTL_HOURS=1
# LC_MESSAGE_TTL_HOURS=24
